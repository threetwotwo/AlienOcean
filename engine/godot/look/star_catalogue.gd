## Star catalogue 0.1.0 (engine thread): the bright stars of the night sky, catalogue v2 of the Unreal sky (sun_v184
## STARS_HLSL: CAT[2319] and CATS[385], copied value for value by a bake script; v84 option C's stars, v87's natural sky).
## 1914 stars in 2319 entries: binned on a cube, 6 faces x 8 x 8, with a 0.6 deg overlap, so a star near a bin's edge is in
## both. One entry = direction x (B-V + 2), magnitude. BINS[i] .. BINS[i + 1] = the entries of bin face * 64 + v * 8 + u.
## texture() packs both into one float image for look/sky_stars.gdshaderinc: entry i at texel (i % 64, i / 64), bin
## start i at texel 2368 + i (red). Built at run time, so no import settings can change the numbers.
class_name StarCatalogue
extends RefCounted

const W := 64
const BINS_AT := 2368          # first texel of the bin table (row 37)

static func texture() -> ImageTexture:
	var n: int = CAT.size() / 4
	var h: int = (BINS_AT + BINS.size() + W - 1) / W
	var f := PackedFloat32Array(); f.resize(W * h * 4); f.fill(0.0)
	for i: int in CAT.size(): f[i] = CAT[i]
	for i: int in BINS.size(): f[(BINS_AT + i) * 4] = float(BINS[i])
	assert(n * 4 == CAT.size() and n <= BINS_AT)
	return ImageTexture.create_from_image(Image.create_from_data(W, h, false, Image.FORMAT_RGBAF, f.to_byte_array()))

