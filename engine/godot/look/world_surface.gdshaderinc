void h66(inout WsG Wg_, float3 p, out float3 a, out float3 b){ WS_COUNT_HASH uint3 h = pcg3(Wg_, uint3(int3(floor(p)) + 1048576)); a = float3(h & uvec3(65535u))*(2.0/65536.0) - 1.; b = float3(h >> uvec3(16u))*(2.0/65536.0) - 1.; }
float2 gd2(inout WsG Wg_, float3 i, float3 f, float3 c){ float3 a, b; h66(Wg_, i + c, a, b); return float2(dot(a, f - c), dot(b, f - c)); }
float2 vn3v(inout WsG Wg_, float3 p){ float3 i = floor(p), f = frac(p), u = f*f*f*(f*(f*6. - 15.) + 10.);
