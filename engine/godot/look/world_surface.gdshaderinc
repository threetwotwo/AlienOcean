// ---------- hashed noise: world position in, no period ----------
// integer hash (pcg3d, Jarzynski and Olano 2020) on the lattice cell: the common fract(p*0.1031) hash repeats about every 9.7 cells,
// which the repeat test found in Colony's fan surface (12 Nov)
uint3 pcg3(inout WsG Wg_, uint3 v){ v = v*1664525u + 1013904223u; v.x += v.y*v.z; v.y += v.z*v.x; v.z += v.x*v.y; v ^= v >> uvec3(16u); v.x += v.y*v.z; v.y += v.z*v.x; v.z += v.x*v.y; return v; }
