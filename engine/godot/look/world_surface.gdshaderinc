float vn3(inout WsG Wg_, float3 p){ float3 i = floor(p), f = frac(p), u = f*f*f*(f*(f*6. - 15.) + 10.);        // gradient noise (thresholded value noise gave square-edged patches), 0..1, mean 0.5
