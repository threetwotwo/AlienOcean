float fbm2(inout WsG Wg_, float3 p){ p = r3(Wg_, p); float s = 0.5*vn3(Wg_, p); p = r3(Wg_, p)*2.03 + float3(17.3, 5.1, 9.7); return (s + 0.25*vn3(Wg_, p))/0.875; }   // first two octaves of fbm3(Wg_, what the island maps hold)
float fo3(inout WsG Wg_, float3 p){ p = r3(Wg_, p); p = r3(Wg_, p)*2.03 + float3(17.3, 5.1, 9.7); p = r3(Wg_, p)*2.03 + float3(17.3, 5.1, 9.7); return vn3(Wg_, p)*0.142857; }   // its third octave alone (per pixel): fbm3 = fbm2 + fo3
