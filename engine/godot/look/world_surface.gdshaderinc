// ---------- polyp mask (art bible palette.tree_glow, Slice look): grey 0..1, no colour; Unreal: emissive = bible colour x strength x mask ----------
// dots on cells of "cell" metres, gathered in mottled patches (pat.x to pat.y, floor pat.z), more on faces that look up, fading to an even 0.16
// once a pixel covers fd.x to fd.y cells. World position and the integer hash: no tile, no period. The numbers come from the bible export.
struct WsPolyp { float cell; float3 pat; float2 fd; };
float polypMask(inout WsG Wg_, WsPolyp q, float3 nrm){
  float3 pq = Wg_.gP/q.cell; float fw = length(fwidth(pq)); float3 i = floor(pq), f = frac(pq); float d = 8.;
  for (int z = -1; z <= 1; z++) for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) { float3 g = float3(float(x), float(y), float(z)); float3 r = g + hu3(Wg_, i + g + 911.)*0.8 + 0.1 - f; d = min(d, dot(r, r)); }
  float dt = lerp(1. - smoothstep(0.015, 0.09, d), 0.16, smoothstep(q.fd.x, q.fd.y, fw));
  float pat = smoothstep(q.pat.x, q.pat.y, sat(Wg_, (0.55*vn3(Wg_, Wg_.gP*2.3 + 3.1) + 0.45*vn3(Wg_, Wg_.gP*6.1 + 7.7) - 0.5)*2.4 + 0.5));
  float up = 0.3 + 0.7*smoothstep(-0.4, 0.8, nrm.z);
  return dt * (q.pat.z + (1. - q.pat.z)*pat) * up; }

// ---------- Colony maker's brain valleys (colony.js SURF_GLSL phasorPh; Tricard et al. 2019 phasor noise) ----------
// even-width stripes whose direction follows a smooth field, and septa across them from the SAME kernels. A labyrinth cannot be cut into
// random patches (the patches chop the valleys into worms and the septa into fingerprint scraps), so the meander kinds run this per
// pixel instead of a tile. p in mm. 27 kernels: only inside its fade distance.
float3 tangentOf(inout WsG Wg_, float3 v, float3 n){ float3 t = v - n*dot(v, n); float l = length(t); if (l > 1e-4) return t/l; float3 a = abs(n.x) < 0.9 ? float3(1, 0, 0) : float3(0, 1, 0); return normalize(a - n*dot(a, n)); }
float2 phasorPh(inout WsG Wg_, float3 p, float3 n, float lam, float sep){ float3 q4 = p/(8.*lam);
  float3 d = tangentOf(Wg_, float3(vn3(Wg_, q4), vn3(Wg_, q4 + float3(17.1, 0, 0)), vn3(Wg_, q4 + float3(0, 41.7, 0))) - 0.5, n);
  float c = 1.3*lam; float3 qc = floor(p/c), t = cross(n, d); float2 G = f2(Wg_, 0.), G2 = f2(Wg_, 0.);
  for (int k = -1; k <= 1; k++) for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) { float3 g = qc + float3(float(i), float(j), float(k)), o = hu3(Wg_, g + 0.5), x = p - (g + o)*c;
    float w = exp(-dot(x, x)/(c*c*0.3)), ph = 6.2831853*dot(d, x)/lam + 6.2831853*o.z, ps = 6.2831853*dot(t, x)/sep + 6.2831853*o.y;
    G += w*float2(cos(ph), sin(ph)); G2 += w*float2(cos(ps), sin(ps)); }
  return float2(atan2(G.y, G.x), atan2(G2.y, G2.x)); }
float fadeOf(inout WsG Wg_, float sz, float fw){ return clamp((sz/fw - 2.)/3., 0., 1.); }

// ---------- one ripple family in a FIXED direction (Seabed's crest shape hr = 1 - 2|sin(ph/2)|^1.3): adds its weighted height, slope and weight ----------
// g = (ddx(pr), ddy(pr)), gw = d(warp) per pixel: the phase change per pixel is worked out from these CONTINUOUS fields, never as ddx(ph): where the
// picked direction index steps between two pixels, ddx(ph) is garbage and drew thin dashed flat lines across the dunes (island window 'slip', 12 Nov)
void ripple(inout WsG Wg_, float2 pr, float ang, float lam, float amp, float warp, float w, float fp, float4 g, float2 gw, inout float hs, inout float2 sl, inout float ws){
  if (w < 0.001) return; float2 d = float2(cos(ang), sin(ang)); float ph = 6.2831853*dot(pr, d)/lam + warp;
  float dph = length(float2(6.2831853*dot(g.xy, d)/lam + gw.x, 6.2831853*dot(g.zw, d)/lam + gw.y)), f = sat(Wg_, lam/(6.*fp) - 0.5) * sat(Wg_, 1.6 - dph) * (w - 0.001);   // fades by footprint and by phase change per pixel; w - 0.001: the skip under 0.001 is continuous (Terrain 12 Nov: lone-pixel steps)
  float sa = sin(ph*0.5); hs += (1. - 2.*pow(abs(sa), Wg_.gRex))*f; sl += amp*(-Wg_.gRex*pow(abs(sa) + 0.02, Wg_.gRex - 1.)*(sa/(abs(sa) + 0.02))*cos(ph*0.5))*(6.2831853/lam)*d*f; ws += f; }   // slope: the crest cusp rounded over |sin| < 0.02 (about 1 mm), so it never flips sign between two pixels (Terrain 12 Nov)

// ---------- stochastic tile read: a bent triangle grid, each corner reads the tile at a random offset and quarter turn ----------
float2 qrot(inout WsG Wg_, float2 v, float q){ return q < 0.5 ? v : q < 1.5 ? float2(-v.y, v.x) : q < 2.5 ? -v : float2(v.y, -v.x); }
struct St { float2 u0, u1, u2; float3 w; float q0, q1, q2; float2 dx, dy; };
St stGrid(inout WsG Wg_, float2 uv){ St s; s.dx = ddx(uv); s.dy = ddy(uv);
  if (Wg_.gStochOff > 0.5) { s.u0 = uv; s.u1 = uv; s.u2 = uv; s.w = float3(1., 0., 0.); s.q0 = 0.; s.q1 = 0.; s.q2 = 0.; return s; }
  float2 wn = vn3v(Wg_, float3(uv*0.9, 1.7)) - 0.5;                    // bend the grid itself, so the patches have no straight or regular borders
  wn += 0.5*(vn3v(Wg_, float3(uv*2.3, 4.4)) - 0.5);                    // and a finer bend: the blend pattern itself must not form a lattice
  float2 gi = uv*1.7 + wn*1.5; float2 g = float2(gi.x - 0.57735027*gi.y, 1.15470054*gi.y); float2 b = floor(g), f = frac(g); float t = 1. - f.x - f.y; float2 c0, c1, c2;
  if (t > 0.) { s.w = float3(t, f.y, f.x); c0 = b; c1 = b + float2(0., 1.); c2 = b + float2(1., 0.); } else { s.w = float3(-t, 1. - f.y, 1. - f.x); c0 = b + f2(Wg_, 1.); c1 = b + float2(1., 0.); c2 = b + float2(0., 1.); }
  float3 h0 = hash3(Wg_, c0), h1 = hash3(Wg_, c1), h2 = hash3(Wg_, c2); s.q0 = floor(h0.z*4.); s.q1 = floor(h1.z*4.); s.q2 = floor(h2.z*4.);
  s.u0 = qrot(Wg_, uv, s.q0) + h0.xy; s.u1 = qrot(Wg_, uv, s.q1) + h1.xy; s.u2 = qrot(Wg_, uv, s.q2) + h2.xy; return s; }
float4 sg(inout WsG Wg_, TEXARG(t), float2 u, float q, St s){ WS_COUNT_READ return TEXW(t, u, qrot(Wg_, s.dx, q), qrot(Wg_, s.dy, q)); }
float3 stW(inout WsG Wg_, TEXARG(orm), St s, out float3 o){       // corner weights sharpened by each corner's height (ORM.b), and the blended ORM
  float3 a = sg(Wg_, TEXUSE(orm), s.u0, s.q0, s).rgb, b = sg(Wg_, TEXUSE(orm), s.u1, s.q1, s).rgb, c = sg(Wg_, TEXUSE(orm), s.u2, s.q2, s).rgb;
  float3 w = s.w*s.w*s.w * (0.10 + 3.*float3(a.b*a.b, b.b*b.b, c.b*c.b)); w /= (w.x + w.y + w.z);
  // COST (12 Nov, Optimise's corner lever): a corner under 4 % adds nothing visible; subtracting (not cutting) keeps the weights continuous, so
  // no contour line, and stC / stN skip the colour and normal reads of a corner whose weight is 0
  w = max(w - 0.04, f3(Wg_, 0.)); w /= (w.x + w.y + w.z); o = a*w.x + b*w.y + c*w.z; return w; }
float3 stC(inout WsG Wg_, TEXARG(t), St s, float3 w){ float3 c = f3(Wg_, 0.);   // reads with explicit gradients: safe inside these branches
  if (w.x > 0.) c += sg(Wg_, TEXUSE(t), s.u0, s.q0, s).rgb*w.x; if (w.y > 0.) c += sg(Wg_, TEXUSE(t), s.u1, s.q1, s).rgb*w.y; if (w.z > 0.) c += sg(Wg_, TEXUSE(t), s.u2, s.q2, s).rgb*w.z; return c; }
float3 unpackN(inout WsG Wg_, float4 c){ return WS_UNPACKN(c); }
float3 stN(inout WsG Wg_, TEXARG(t), St s, float3 w){ float3 a = float3(0., 0., 1.), b = a, c = a;
  if (w.x > 0.) a = unpackN(Wg_, sg(Wg_, TEXUSE(t), s.u0, s.q0, s)); if (w.y > 0.) b = unpackN(Wg_, sg(Wg_, TEXUSE(t), s.u1, s.q1, s)); if (w.z > 0.) c = unpackN(Wg_, sg(Wg_, TEXUSE(t), s.u2, s.q2, s));
  a.xy = qrot(Wg_, a.xy, pmod(Wg_, 4. - s.q0, 4.)); b.xy = qrot(Wg_, b.xy, pmod(Wg_, 4. - s.q1, 4.)); c.xy = qrot(Wg_, c.xy, pmod(Wg_, 4. - s.q2, 4.)); return normalize(a*w.x + b*w.y + c*w.z); }
// one tile, world aligned on the three planes (only the planes that count are read): colour, ORM, world normal
void tileRead(inout WsG Wg_, TEXARG(bc), TEXARG(nm), TEXARG(orm), float T, float k, out float3 c, out float3 o, out float3 n){
  c = f3(Wg_, 0.); o = f3(Wg_, 0.); n = f3(Wg_, 0.); float3 oo, tn; float3 w;
  if (Wg_.gW.x > 0.) { St s = stGrid(Wg_, Wg_.gP.yz/T); w = stW(Wg_, TEXUSE(orm), s, oo); c += stC(Wg_, TEXUSE(bc), s, w)*Wg_.gW.x; o += oo*Wg_.gW.x; tn = k > 0. ? stN(Wg_, TEXUSE(nm), s, w) : float3(0., 0., 1.); tn.xy *= k; n += float3(tn.xy + Wg_.gNn.zy, abs(tn.z)*Wg_.gNn.x).zyx*Wg_.gW.x; }
  if (Wg_.gW.y > 0.) { St s = stGrid(Wg_, Wg_.gP.xz/T + 7.3); w = stW(Wg_, TEXUSE(orm), s, oo); c += stC(Wg_, TEXUSE(bc), s, w)*Wg_.gW.y; o += oo*Wg_.gW.y; tn = k > 0. ? stN(Wg_, TEXUSE(nm), s, w) : float3(0., 0., 1.); tn.xy *= k; n += float3(tn.xy + Wg_.gNn.xz, abs(tn.z)*Wg_.gNn.y).xzy*Wg_.gW.y; }
  if (Wg_.gW.z > 0.) { St s = stGrid(Wg_, Wg_.gP.xy/T + 3.1); w = stW(Wg_, TEXUSE(orm), s, oo); c += stC(Wg_, TEXUSE(bc), s, w)*Wg_.gW.z; o += oo*Wg_.gW.z; tn = k > 0. ? stN(Wg_, TEXUSE(nm), s, w) : float3(0., 0., 1.); tn.xy *= k; n += float3(tn.xy + Wg_.gNn.xy, abs(tn.z)*Wg_.gNn.z).xyz*Wg_.gW.z; }
  c /= (Wg_.gW.x + Wg_.gW.y + Wg_.gW.z); o /= (Wg_.gW.x + Wg_.gW.y + Wg_.gW.z); n = normalize(n); }   // k = 0: no normal is read (the crust layer uses colour only)

// two tiles on the same grids (COST 12 Nov): the second (colour only, its own ORM for the corner weights) reuses each plane's stochastic grid,
// whose bends cost two noise octaves a plane. on2 <= 0.01: the second tile is not read. Both tiles are read at the first tile's size T.
void tileRead2(inout WsG Wg_, TEXARG(bc), TEXARG(nm), TEXARG(orm), TEXARG(bc2), TEXARG(orm2), float T, float k, float on2, out float3 c, out float3 o, out float3 n, out float3 c2){
  c = f3(Wg_, 0.); o = f3(Wg_, 0.); n = f3(Wg_, 0.); c2 = f3(Wg_, 0.); float3 oo, tn, w;
  if (Wg_.gW.x > 0.) { St s = stGrid(Wg_, Wg_.gP.yz/T); w = stW(Wg_, TEXUSE(orm), s, oo); c += stC(Wg_, TEXUSE(bc), s, w)*Wg_.gW.x; o += oo*Wg_.gW.x; tn = stN(Wg_, TEXUSE(nm), s, w); tn.xy *= k; n += float3(tn.xy + Wg_.gNn.zy, abs(tn.z)*Wg_.gNn.x).zyx*Wg_.gW.x;
    if (on2 > 0.01) { w = stW(Wg_, TEXUSE(orm2), s, oo); c2 += stC(Wg_, TEXUSE(bc2), s, w)*Wg_.gW.x; } }
  if (Wg_.gW.y > 0.) { St s = stGrid(Wg_, Wg_.gP.xz/T + 7.3); w = stW(Wg_, TEXUSE(orm), s, oo); c += stC(Wg_, TEXUSE(bc), s, w)*Wg_.gW.y; o += oo*Wg_.gW.y; tn = stN(Wg_, TEXUSE(nm), s, w); tn.xy *= k; n += float3(tn.xy + Wg_.gNn.xz, abs(tn.z)*Wg_.gNn.y).xzy*Wg_.gW.y;
    if (on2 > 0.01) { w = stW(Wg_, TEXUSE(orm2), s, oo); c2 += stC(Wg_, TEXUSE(bc2), s, w)*Wg_.gW.y; } }
  if (Wg_.gW.z > 0.) { St s = stGrid(Wg_, Wg_.gP.xy/T + 3.1); w = stW(Wg_, TEXUSE(orm), s, oo); c += stC(Wg_, TEXUSE(bc), s, w)*Wg_.gW.z; o += oo*Wg_.gW.z; tn = stN(Wg_, TEXUSE(nm), s, w); tn.xy *= k; n += float3(tn.xy + Wg_.gNn.xy, abs(tn.z)*Wg_.gNn.z).xyz*Wg_.gW.z;
    if (on2 > 0.01) { w = stW(Wg_, TEXUSE(orm2), s, oo); c2 += stC(Wg_, TEXUSE(bc2), s, w)*Wg_.gW.z; } }
  float ws = Wg_.gW.x + Wg_.gW.y + Wg_.gW.z; c /= ws; o /= ws; c2 /= ws; n = normalize(n); }

// @WS_PARTS@  other threads' part files are put here by ws_export.py and by the lab page (PARTS in ws_export.py; rules in unreal/INTERFACE.md):
// they may call anything above this line and are called by the entry functions below.

// ---------- what every entry function gives back ----------
struct WsSurf { float3 alb; float3 n; float ao; float rough; float pm; float fp; };   // linear albedo, unit normal (island frame), occlusion, roughness, polyp mask 0..1, metres one pixel covers
// start of every entry: the shared state. fp0 = distance x angle of one pixel (or metres per pixel in an ortho view)
float wsBegin(inout WsG Wg_, float3 P, float3 N, float fp0){ Wg_.gP = P; Wg_.gNn = N; Wg_.gWet = float4(0., 0., 1., 1.); Wg_.gDP = float4(ddx(P.xy), ddy(P.xy));
  float3 ng = normalize(cross(ddx(P), ddy(P))); if (dot(ng, N) < 0.) ng = -ng;
  Wg_.gW = pow(abs(normalize(lerp(N, ng, 0.6))), f3(Wg_, 4.)); Wg_.gW /= (Wg_.gW.x + Wg_.gW.y + Wg_.gW.z);
  Wg_.gW = max(Wg_.gW - 0.05, f3(Wg_, 0.)); Wg_.gW /= (Wg_.gW.x + Wg_.gW.y + Wg_.gW.z);   // COST (12 Nov): a plane under 5 % is not read; subtracting keeps the blend continuous   // plane weights lean on the true face: smoothed normals on low meshes (bommie bases) chose the top plane on vertical faces and smeared it into streaks
  return max(fp0, 0.7*max(length(ddx(P)), length(ddy(P)))); }                        // at grazing angles a pixel stretches along the view: fade detail by that, not by distance only

// other threads' ENTRY functions (they return WsSurf and call wsBegin) are put in below this line by ws_export.py (PARTS slot "entries"; Caves' CaveRock)
// @WS_ENTRIES@

// =====================================================================================================================
// THE SAND RIPPLE RULE, one function for every sand in the game: GroundBlend calls it, and so does Unreal's lagoon floor M_Seabed
// (Terrain, import plan row 15), so the two sands cannot drift apart.
// in:  p = position xy (m, island frame), N = unit surface normal, fp = metres one pixel covers,
//      flow = dune flow (c cos 2t, c sin 2t): t = across-crest direction, c = coherence 0..1; (0, 0) = calm families only,
//      trough0, crest0 = dune trough and crest 0..1, mA, mB, mC = the reads of the island field maps T_SandField_A, _B, _C at p
//      (read by the caller at the top of its material, so their gradients are clean), dust = true where sand is only a film on rock
//      (nothing is computed), off = 1 switches ripples off (lab tile test), haze = the caller's fog factor 0..1 (1 = hidden: the ripples
//      fade over 0.85 to 0.98 and nothing ripple-only is computed past 0.98; Optimise 12 Nov: little reads past ~35 m in this water).
// out: hr ripple height -1..1 (crest +), fade 0..1 how much ripple is left at this pixel size, slope (d height / d xy, metres per metre,
//      streaks on lee faces included: normal = normalize(-slope, 1)), trough 0..1 (ripple and dune troughs together: what gathers
//      debris and film), lee 0..1 lee face of a dune, tone = factor on the sand colour (pale crests, film in calm troughs, streaks),
//      sort 0..1 grain sorting (Better sand 14 Nov, plans/better_sand/DESIGN.md section 3): 0 = fine, palest sand (ripple and dune crests),
//      1 = slightly coarser, greyer sand (ripple troughs where ripples stand, dune troughs, dune lee faces). Grown from the same flow field; the
//      caller turns it into colour INSIDE the two locked sand colours (lerp C_sand -> C_sand_d, never darker: SD2) and may coarsen its grain with it.
//      Relief by light: the caller puts slope into its normal (normal = normalize(-slope, 1)); the tone stays about 3 % (SD7).
// A caller outside this file: fp = wsBegin(Wg_, P, N, fp0) first (the pixel size with its grazing-angle stretch); the function reads no other
// shared state. The mA, mB, mC reads: TEXC(fA, WS_MAPUV(p)) and so on, as the first lines of GroundBlend do.
// =====================================================================================================================
// ---------- glitter (Better sand 14 Nov, plans/better_sand/DESIGN.md SD5): sparse single-grain glints, shared by M_Seabed and M_Ground_Blend ----------
// One world cell per pixel-size level (0.4 mm x 2^k, at least 3 pixels), at most one clear grain in it, placed inside the cell's middle so its dot
// never crosses a cell edge (one cell read, no loop). The grain's facet has its own tilt; it glints when it mirrors the sun into the camera, so the
// set changes as the camera moves (twinkle) and holds while the camera is still: no clock, no wobble, no boil. The caller turns the pixel into a
// small mirror (normal -> H, roughness 0.28), so the sun's shadows and caustics light it like the sand around it (no emissive: none in shade).
// 0.28: GGX peak about 6x the sand's own light, so a glint stands 15+ L* over its neighbours without a bloom star (0.08 gave about 1000x;
// 0.35 stood only 12-14 L* in the lab, at the edge of SD5's 10).
// in:  P (m, island frame), N unit normal (with the ripple relief), V unit surface->camera, L unit surface->sun, dP = (ddx(P.xy), ddy(P.xy)) taken
//      by the caller OUTSIDE any branch (wsBegin keeps them in Wg_.gDP),
//      dist metres to the camera, dens glints per megapixel wanted on middle sand (15-60; 0 = off). None past 8 m (fades over 6-8 m).
//      Hand-over: fades IN over 1.0-1.5 m; a caller with its own close glints fades them OUT over the same 1.0-1.5 m (never both at full).
// out: x = glint mask 0..1, yzw = the mirror normal H.
float4 Glitter(inout WsG Wg_, float3 P, float3 N, float3 V, float3 L, float4 dP, float dist, float dens){
  float fd = smoothstep(1.0, 1.5, dist)*(1. - smoothstep(6.0, 8.0, dist));   // 1.5-8 m: inside 1.5 m the close grains carry the sparkle (Terrain 14 Nov, lr54 sand_close)
  if (dens <= 0. || fd <= 0. || dot(N, L) <= 0.) return float4(0., N);
  float dt = dP.x*dP.w - dP.y*dP.z, ad = max(abs(dt), 1e-12);             // ground m^2 one pixel covers (dP = ddx(P.xy), ddy(P.xy), taken by the caller)
  float fpl = max(length(dP.xy), length(dP.zw));                           // the pixel's long side on the ground (stretched along the view)
  float lv = max(ceil(log2(max(3.0*fpl, 4e-4)/4e-4)), 0.), s = 4e-4*exp2(lv);   // cells of 0.4 mm x 2^k, at least 3 pixels on their short side
  float2 q = P.xy/s, id = floor(q);
  float3 h = hu3(Wg_, float3(id, 113. + lv)), h2 = hu3(Wg_, float3(id + 57.3, 7. + lv));
  float2 c = id + 0.3 + 0.4*h.xy;                        // the grain, in the cell's middle
  float2 dw = (q - c)*s, dpx = float2(dP.w*dw.x - dP.z*dw.y, -dP.y*dw.x + dP.x*dw.y)/(abs(dt) > 1e-12 ? dt : 1e-12);   // ground offset -> screen pixels: round dots on screen at any angle
  float rpx = 0.6 + 0.5*h2.z;                            // radius 0.6-1.1 px: dots 1-2.5 px, up to 3 with the soft rim (lab sa-glit 5: 0.5-1.0 read as 1 px)
  float disc = 1. - smoothstep(rpx, rpx + 0.5, length(dpx));
  float3 H = normalize(L + V);
  // the facet's slope off the surface: wide (sd 0.8), so a grain somewhere mirrors the sun for any camera (lab sa-glit 1: a 35 deg cap gave none
  // from a swimming eye with the sun high). Wanted glints per pixel / cells per pixel / the chance a facet mirrors H, so the count holds from any
  // view, a little higher toward the sun's mirror (wsun 0.6-1.4), as Gary liked the v28 glints gathering there.
  float2 t = 0.8*sqrt(-2.*log(max(h2.x, 1e-4)))*float2(cos(6.2831853*h2.y), sin(6.2831853*h2.y));
  float3 fn = normalize(N + float3(t, 0.));              // near-flat sand: slope in the island xy plane
  float ct = exp(-(1. - dot(fn, H))/6.8e-4);             // mirrors within about 2 deg (a 0.3 m camera move at 6 m turns H by 1.4 deg: most still change)
  float on = smoothstep(0.30, 0.60, ct);                 // a grain that mirrors is a whole mirror (lab sa-glit 4: a graded ct left half-tilted normals that never lit)
  float2 ts = H.xy/max(H.z, 0.05) - N.xy/max(N.z, 0.05); float t2 = dot(ts, ts);   // the slope a facet needs to mirror the sun
  float pdf = exp(-t2/1.28)/4.0212, Pm = pdf*0.0043*(1. + t2)*(1. + t2);           // gaussian slope density x the mirror cone (2 pi 6.8e-4 sr) in slope space
  // (lab sa-glit 5: sd 0.6 with a 1.5 deg cone asked for more than one glint per cell at grazing views, so 6-8 m came up short)
  float wsun = 0.6 + 0.8*exp(-t2);
  float pc = dens*1e-6*(s*s/ad)*wsun/max(Pm, 1e-7);    // glints per pixel wanted x pixels per cell / chance the facet mirrors: dens = glints per Mpx
  return float4(disc*on*step(h.z, pc)*fd, H); }
// ---------- WS_BAKED hooks (Godot side, tools/ws_to_godot.py): the sand's fixed world-xy noise fields, baked or procedural ----------
float wsWarpC(inout WsG Wg_, float2 p){ return 1.2*(fbm2n(Wg_, float3(p/0.8, 3.)) - 0.5)*2. + 10.*fo3(Wg_, float3(p/2.0, 0.)); }
#ifdef WS_BAKED
float wsBkK(float2 p){ float2 e = min(p - sand_box.xy, sand_box.xy + sand_box.zw - p); return sand_on * clamp(min(e.x, e.y), 0., 1.); }
float4 wsBkRead(inout WsG Wg_, sampler2D t, float2 p){ float2 s = (sand_px - 1.)/sand_box.zw, g = s/sand_px; WS_COUNT_READ
  return textureGrad(t, ((p - sand_box.xy)*s + 0.5)/sand_px, Wg_.gDP.xy*g, Wg_.gDP.zw*g); }
float wsBk1(inout WsG Wg_, float2 p, int c){ float k = wsBkK(p); float b = 0.;
  if (k > 0.) { float4 v = c < 4 ? wsBkRead(Wg_, sandA, p) : wsBkRead(Wg_, sandB, p); b = c == 0 ? v.x : c == 1 ? v.y/7. : c == 2 ? v.z/7. : c == 3 ? v.w/7. : v.x - 8.; }
  if (k >= 1.) return b;
  float f = c == 0 ? fbm2n(Wg_, float3(p/1.4, 19.)) : c == 1 ? fo3(Wg_, float3(p/2.5, 71.)) : c == 2 ? fo3(Wg_, float3(p/2.2, 83.)) : c == 3 ? fo3(Wg_, float3(p/2.1, 29.)) : wsWarpC(Wg_, p);
  return lerp(f, b, k); }
float2 wsBkPr(inout WsG Wg_, float2 p){ float k = wsBkK(p); float2 b = f2(Wg_, 0.); if (k > 0.) b = wsBkRead(Wg_, sandB, p).yz;
  if (k >= 1.) return b; return lerp(fbm2v(Wg_, float3(p/1.2, 41.)), b, k); }
#define WS_F_RDG(p) wsBk1(Wg_, p, 0)
#define WS_F_CW(p) wsBk1(Wg_, p, 1)
#define WS_F_WL(p) wsBk1(Wg_, p, 2)
#define WS_F_DL(p) wsBk1(Wg_, p, 3)
#define WS_F_WARPC(p) wsBk1(Wg_, p, 4)
#define WS_F_PR(p) wsBkPr(Wg_, p)
#else
#define WS_F_RDG(p) fbm2n(Wg_, float3((p)/1.4, 19.))
#define WS_F_CW(p) fo3(Wg_, float3((p)/2.5, 71.))
#define WS_F_WL(p) fo3(Wg_, float3((p)/2.2, 83.))
#define WS_F_DL(p) fo3(Wg_, float3((p)/2.1, 29.))
#define WS_F_WARPC(p) wsWarpC(Wg_, p)
#define WS_F_PR(p) fbm2v(Wg_, float3((p)/1.2, 41.))
#endif
struct WsRipple { float hr; float fade; float2 slope; float trough; float lee; float3 tone; float sort; };
WsRipple SandRipples(inout WsG Wg_, float2 p, float3 N, float fp, float2 flow, float trough0, float crest0, float4 mA, float4 mB, float4 mC, bool dust, float off, float haze){
  WsRipple R; float up = N.z;
  // two ripple families (Unreal's fixed one: 0.18 m, 35 mm, 0.6 rad; and a finer one turned 0.5 rad) trade places over 10 m; crests wander, fork and pinch;
  // whole fields fade to smooth sand. Nothing here is a tile: phase comes from world position and hashed noise.
  // Slice look 04:27Z: no factor on the whole phase (it made the wavenumber grow with distance from the world origin: no ripples at the basin);
  // warp only at scales above the ridge's own, so crests stay crests. Spacing variety (+-25 %) comes from the warp's gradient.
  // FAR PATH (exact): every ripple family is fully faded once a pixel covers more than a third of the longest spacing (0.23 m), so nothing that only feeds the ripples is computed there
  bool noRip = dust || fp > 0.08 || haze > 0.98;
  float nA = 0.5, nCw = 0.5, nGate = 0., nEx = 0.5, nWl = 0.5, nRdg = 0.5;
  if (!noRip) { nRdg = fbS(Wg_, WS_F_RDG(p)); nA = mC.b; nCw = fbS(Wg_, 0.1286 + 0.6*mA.r + WS_F_CW(p)); nGate = mC.a; nEx = mB.g; nWl = fbS(Wg_, 0.1286 + 0.6*mA.g + WS_F_WL(p)); }
  float wA = smoothstep(0.15, 0.85, nA);
  // dune flow (World Sketch round 98), per vertex: flow = (c cos 2t, c sin 2t): t = across-crest direction (axial), c = coherence 0..1.
  // Doubled angle so the direction interpolates across its 0/pi flip. A direction that varies in space must never multiply world position (p . d(x)
  // puts a 150 m lever on every small turn), so the flow picks the two nearest of 8 fixed directions over [0, pi) and blends them: each fixed family
  // is coherent everywhere, the phase belongs to the direction (not the slot), and index 8 is index 0, so the wrap has no seam (Slice look 04:41Z).
  // Where coherence is under 0.3 to 0.7, Unreal's calm families (0.6 rad at 0.18 m, 1.1 rad at 0.13 m) take over: where two dune flows meet
  // the doubled-angle vector shrinks and its direction snaps; the calm families must already own that ground.
  float coh = length(flow), cwR = smoothstep(0.30, 0.70, coh);
  // hand-over between the flow-turned ripples and the calm families: NOT a cross-fade (two crossing families at half strength each read as a
  // criss-cross waffle, island window 'flat' 12 Nov); a ragged mosaic of patches instead, one family per patch, cwR = the flow's share of patches
  float cw = smoothstep(0.42, 0.58, cwR + clamp((nCw - 0.5)*1.6, -0.4, 0.4));
  float th = 0.5*atan2(flow.y, flow.x + 1e-6); th = th < 0. ? th + 3.1415927 : th; float qa = th/0.3926991, q0 = floor(qa), qf = smoothstep(0.25, 0.75, qa - q0);
  float2 rdF = float2(cos(th), sin(th));
  // lee faces: slope over about 17 to 27 deg and facing along the flow: no ripples, faint grain-flow streaks down the slope instead
  float2 dn = N.xy; float slp = length(dn), lee = cw * smoothstep(0.30, 0.50, slp) * smoothstep(0.1, 0.4, abs(dot(dn/max(slp, 1e-4), rdF)));
  float warp = 0.; float2 pr = p;
  if (!noRip) { warp = WS_F_WARPC(p) + 1.0*(fbm2n(Wg_, float3(p/0.45, 7.)) - 0.5)*2.;
    warp += 24.*mB.r - 12.;   // the map holds the warp's two large terms; short kicks pinch and fork the crests (without them a flow-turned field read as corduroy)
    pr = p + 0.25*(WS_F_PR(p) - 0.5); }      // crests turn locally
  float rAmp = (1. - lee)*0.8*smoothstep(0.12, 0.42, nGate)*lerp(0.35, 1.3, smoothstep(0.34, 0.66, nRdg))*smoothstep(0.20, 0.36, nRdg) * smoothstep(0.85, 0.97, up) * (1. - off) * (1. - smoothstep(0.85, 0.98, haze));
  float hs = 0., fade = 0.; float2 slope = f2(Wg_, 0.); Wg_.gRex = lerp(1.05, 1.75, smoothstep(0.25, 0.75, nEx));
  float4 gpr = float4(ddx(pr), ddy(pr)); float2 gwp = float2(ddx(warp), ddy(warp));
  // two wavelengths per family in a ragged mosaic (one per patch): ripple spacing changes from field to field, and crests fork where the fields meet
  float wl = smoothstep(0.40, 0.60, nWl);
  for (int j = 0; j < 2; j++) { float lam = j == 0 ? 0.20 : 0.15, am = j == 0 ? 0.0195 : 0.0145, wj = j == 0 ? 1. - wl : wl;
    float i0 = pmod(Wg_, q0, 8.), i1 = pmod(Wg_, q0 + 1., 8.);   // spacing per direction index, +-15 %
    ripple(Wg_, pr, i0*0.3926991, lam*(1. + 0.15*sin(i0*2.399 + 0.7)), am, warp, rAmp*cw*(1. - qf)*wj, fp, gpr, gwp, hs, slope, fade);
    ripple(Wg_, pr, i1*0.3926991, lam*(1. + 0.15*sin(i1*2.399 + 0.7)), am, warp, rAmp*cw*qf*wj, fp, gpr, gwp, hs, slope, fade);
    ripple(Wg_, pr, 0.6, lam, am, warp, rAmp*(1. - cw)*wA*wj, fp, gpr, gwp, hs, slope, fade); }
  ripple(Wg_, pr, 1.1, 0.13, 0.011, warp*1.3, rAmp*(1. - cw)*(1. - wA)*0.7, fp, gpr, gwp*1.3, hs, slope, fade);
  float hr = hs/max(fade, 0.01);   // hr goes to 0 with the last 1 % of ripple weight, never switches (was 1e-4: a family at 0.1 % weight gave full height or none)
  R.trough = max(lerp(0.5, sat(Wg_, 0.5 - 0.5*hr), fade), trough0);                                                      // ripple troughs and dune troughs both gather debris and film
  float macG = mC.g;
  R.tone = (1. + (hr > 0. ? 0.02 : 0.035)*hr*fade) * (1. - 0.05*trough0 + 0.05*crest0) * lerp(f3(Wg_, 1.), float3(0.90, 0.88, 0.76), 0.5*sat(Wg_, macG*1.6 - 0.5)*(0.35 + 0.65*sat(Wg_, 0.2 - hr*fade)));   // pale crests, a faint film in calm troughs
  if (lee > 0.01 && !noRip) { float la = atan2(dn.y, dn.x)/0.3926991, l0 = floor(la), lf = la - l0; float st = 0.; float2 tq = f2(Wg_, 0.);    // streaks in the two nearest of 16 fixed down-slope directions (same reason as above)
    for (int j2 = 0; j2 < 2; j2++) { float aj = (l0 + float(j2))*0.3926991; float2 dd = float2(cos(aj), sin(aj)), tj = float2(-dd.y, dd.x); float wj = j2 == 0 ? 1. - lf : lf;
      float sp = dot(p, tj)/0.045 + 2.*(fbm3(Wg_, float3(p/0.8, 51.)) - 0.5)*2. + 0.4*dot(p, dd);
      st += wj * smoothstep(0.55, 1.0, 0.5 + 0.5*sin(6.2831853*sp)) * smoothstep(0.35, 0.7, fb(Wg_, float3(dot(p, dd)/0.6, dot(p, tj)/0.12, 61.))); tq += wj*tj; }
    st *= lee * sat(Wg_, 0.045/(4.*fp) - 0.5);
    R.tone *= 1. - 0.06*st; slope += 0.02*st*tq; }                                                                            // grain-flow streaks: faint, short, down the slope
  // grain sorting (Better sand): coarse in ripple troughs only where ripples really stand (rAmp), in dune troughs and on dune lee faces; fine on crests
  R.sort = sat(Wg_, 0.65*sat(Wg_, 0.5 - 0.5*hr)*fade*sat(Wg_, rAmp*1.25) + 0.55*trough0 + 0.6*lee - 0.35*crest0);
  R.hr = hr; R.fade = fade; R.slope = slope; R.lee = lee; return R; }

// =====================================================================================================================
// M_Ground_Blend: floor, sand banks, opening lips, wall ring, cave mouths, bommies
// =====================================================================================================================
struct WsGround {
  float kind;            // 0 ground, 1 cave mouth (vertex tone = beds)
  float share;           // sand share 0..1 from the export (COLOR_0 alpha)
  float2 flow;           // dune flow (c cos 2t, c sin 2t): t = across-crest direction, c = coherence (TEXCOORD_1); (0, 0) = calm families
  float trough, crest;   // dune trough and crest 0..1 (TEXCOORD_2)
  float3 vc;             // the mesh's own colour, linear (cave mouths: its tone against the rock colour draws the beds)
  float3 open0, open1;   // slice openings (m): sand gathers within 4 to 8 m; far away = none
  float floorZ, rockT, noRipple, haze;   // turf only 3 to 5 m above floorZ; rock tile size (0.30 m); 1 = ripples off (lab tile test only); fog 0..1 (SandRipples)
  float glit; float3 cam, sun;           // Better sand glitter: glints per megapixel wanted (0 = off, nothing computed); camera position (m, island frame); unit direction to the sun
  float3 cSand, cSandD, cRock, cCrev, cTurf, cCrust, cRubA, cRubB, cRubMid;   // locked bible colours, linear; cRubMid = the sRGB midpoint of the two rubble colours, linear
  float3 mRock, mTurf, mCrust, mGrain; };   // linear means of the tiles: albedo = lock * tile / mean
WsSurf GroundBlend(inout WsG Wg_, float3 P, float3 N, float fp0, WsGround G,
    TEXARG(rBC), TEXARG(rN), TEXARG(rORM), TEXARG(tBC), TEXARG(tN), TEXARG(tORM), TEXARG(cBC), TEXARG(cN), TEXARG(cORM),
    TEXARG(gBC), TEXARG(gN), TEXARG(gM), TEXARG(dBC), TEXARG(dN), TEXARG(dM), TEXARG(fA), TEXARG(fB), TEXARG(fC), TEXARG(fD)){
  WsSurf S; float fp = wsBegin(Wg_, P, N, fp0); float up = N.z; S.fp = fp; S.pm = 0.;
  float3 alb = f3(Wg_, 0.); float3 n = N; float ao = 1., rough = 0.85;
  // the island sand field maps (sand_field_maps.py): the large fields, 4 reads. Outside the 600 m square the edge value holds.
  float2 fuv = WS_MAPUV(P.xy);
  float4 mA = TEXC(fA, fuv), mB = TEXC(fB, fuv), mC = TEXC(fC, fuv), mD = TEXC(fD, fuv); WS_COUNT_READ4
  float F6 = mD.g, F20 = mC.r;   // map C red is the macro field 0.5 F20 + 0.5 macR: with F20 = macR = that value every use below reads it
  if (up < 0.80) F6 = lerp(fbS(Wg_, fbm2n(Wg_, P/6.0)), F6, smoothstep(0.70, 0.80, up));   // the map field is flat (no z): steep faces blend to the 3D field, so walls keep their look
  float nearOpen = 1. - smoothstep(4., 8., min(length(P.xy - G.open0.xy), length(P.xy - G.open1.xy)));
  float shr = G.kind < 0.5 ? lerp(G.share, 1., nearOpen) : G.share;
  float e = sat(Wg_, 4.*shr*(1. - shr)*1.6);
  // ONLY WHAT COUNTS (Optimise, 12 Nov): on pure sand (share 1, facing up) nothing of the rock is read or computed; where sand is only a dusting on a rock top, no ripples, debris or grains are computed.
  // exact bounds, not guesses: s = share + e*(noise +- 0.225 from the rock height); if even the lowest possible s is over the threshold the pixel is sand whatever the rock tile says
  bool pureSand = up > 0.80 && shr + e*((F6 - 0.5)*0.45 - 0.535) > 0.531;
  float F1 = 0.5, F1b = 0.5, F03 = 0.5, sandM = 1., ledge = 0.;
  if (!pureSand) {
    float2 f12 = fbm3v(Wg_, P/1.2 + 31.7); F1 = fbS(Wg_, f12.x); F1b = fbS(Wg_, f12.y);
    F03 = fb(Wg_, P/0.33 + 5.3 + 1.2*(float3(F1, F1b, F6) - 0.5));
    if (up > 0.80 && shr + e*((F1 - 0.5)*0.50 + (F6 - 0.5)*0.45 + (F03 - 0.5)*0.12 - 0.225) > 0.531) pureSand = true;
  }
  if (!pureSand) {
    float wall = 1. - smoothstep(0.55, 0.80, up), seam = 0.;
    float crustM = wall * (1. - nearOpen) * smoothstep(0.76, 0.88, F1b*0.5 + F03*0.25 + F6*0.25) * 0.55;   // small soft patches only
    float3 rc, ro, rn, cc; tileRead2(Wg_, TEXUSE(rBC), TEXUSE(rN), TEXUSE(rORM), TEXUSE(cBC), TEXUSE(cORM), G.rockT, 1., crustM, rc, ro, rn, cc);   // the crust tile rides the rock's grids
    float3 rd = toLin(Wg_, rc)/G.mRock; rd = lerp(f3(Wg_, lum(Wg_, rd)), rd, 0.35); rd = lerp(f3(Wg_, 1.), rd, 0.8);
    // 1. sand share: the export's smooth per-vertex share, pushed about by world noise where it is undecided, then decided per pixel
    //    against the rock's own height, so sand lies in the rock's lows and the edge is a grown shoreline, never the 0.5 m raster
    float s = shr + e*((F1 - 0.5)*0.50 + (F6 - 0.5)*0.45 + (F03 - 0.5)*0.12 + 0.45*(0.5 - ro.b));
    sandM = smoothstep(0.47, 0.53, s) * smoothstep(0.50, 0.78, up);
    // COST (12 Nov): where the pixel is wholly sand (sandM exactly 1) the sand below replaces every rock value, so nothing past the share is computed
    if (sandM < 1.) {
    // 2. rock: bare, darker in its cavities; on walls level beds that wander and pinch, and a few steep joints
    if (wall > 0.01) { float zb = P.z/0.62 + 2.2*(fbm2n(Wg_, float3(P.xy/5.5, P.z/2.2) + 13.) - 0.5)*2. + 0.5*(vn3(Wg_, r3(Wg_, float3(P.xy/1.1, P.z/0.6) + 41.)) - 0.5)*2.;
      float d = 0.5 - abs(frac(zb) - 0.5);
      float2 bc = fbm2v(Wg_, float3(P.xy/2.9, P.z/1.6) + 9.3); float bedOn = smoothstep(0.42, 0.58, fbS(Wg_, bc.x)), crackOn = smoothstep(0.52, 0.66, fbS(Wg_, bc.y));   // COST (12 Nov): the two gates of 3 m from ONE pair noise (was two fb: 3 octaves less)
      // steep joints: the 0.5 isoline of one noise, warped by the large fields already made (COST 12 Nov: was Worley cell edges, 27 hashes + a warp)
      float jl = abs(vn3(Wg_, r3(Wg_, float3(P.xy/1.3, P.z/2.4) + 0.35*(float3(F1, F1b, F6) - 0.5) + 27.)) - 0.5);
      seam = max((1. - smoothstep(0.0, 0.05, d))*bedOn*0.8, (1. - smoothstep(0.0, 0.035, jl))*crackOn*0.45) * wall; }
    // weathering at hand-to-arm scale: pitted hollows in clusters (reef limestone), worn paler highs between them
    float3 wv3 = 1.2*(float3(F1b, F6, F1) - 0.5); float F05 = fbS(Wg_, fbm2n(Wg_, P/0.55 + 91. + wv3)), F015 = fbS(Wg_, fbm2n(Wg_, P/0.16 + 63. + wv3*1.7));   // small-scale noise is warped by the larger fields: a lone noise lattice must never show
    float pit = smoothstep(0.56, 0.82, F05*0.62 + F015*0.38)*0.8 * smoothstep(0.35, 0.65, 0.6*F1 + 0.4*(1. - F6));   // ragged hollows of mixed size, in clusters (from the 1.2 m and 6 m fields already made: was its own fb, 3 octaves), never round dots
    ledge = smoothstep(0.72, 0.92, up) * smoothstep(0.45, 0.80, F1b*0.6 + F03*0.4) * (1. - sandM) * 0.40;   // a soft dusting of sediment on tops that face up; never blotches on steep sides
    float top = smoothstep(0.80, 0.93, up) * smoothstep(G.floorZ + 3.0, G.floorZ + 5.0, P.z) * (1. - nearOpen);
    float turfM = top * smoothstep(0.47, 0.55, F6*0.45 + F1b*0.45 + F03*0.10) * (1. - sandM);
    float tone = G.kind > 0.5 ? clamp(lum(Wg_, G.vc)/lum(Wg_, G.cRock), 0.72, 1.12) : 1.;
    float cav = sat(Wg_, (1. - ro.r)*1.6 + seam*0.9 + pit*0.5 + (G.kind > 0.5 ? (1. - tone)*2.0*(1. - G.share) : 0.));
    float3 rock = lerp(G.cRock, G.cCrev, cav) * rd * (0.80 + 0.20*F6 + 0.12*F1 + 0.14*F05);     // tone drifts over metres: never one flat grey
    alb = rock; n = rn; ao = ro.r * (1. - 0.35*seam) * (1. - 0.20*pit); rough = ro.g;
    if (crustM > 0.01) alb = lerp(alb, G.cCrust * lerp(1., lum(Wg_, toLin(Wg_, cc)/G.mCrust), 0.6), crustM);
    if (turfM > 0.01) { float3 c2, o2, n2; tileRead(Wg_, TEXUSE(tBC), TEXUSE(tN), TEXUSE(tORM), 0.20, 1., c2, o2, n2); alb = lerp(alb, G.cTurf * lerp(f3(Wg_, 1.), toLin(Wg_, c2)/G.mTurf, 0.6), turfM); n = normalize(lerp(n, n2, turfM)); }
    }
  }
  // 3. sand: the lagoon sand rules of Unreal's M_Seabed (seabed/handover/sand_v1/sand.json), in the locked sand colours
  if (sandM + ledge > 0.01) {
    float2 p = P.xy;
    bool dust = sandM < 0.01;
    float2 flow = G.kind < 0.5 ? G.flow : f2(Wg_, 0.); float trough0 = G.kind < 0.5 ? G.trough : 0., crest0 = G.kind < 0.5 ? G.crest : 0.;   // cave mouths carry no dune flow: calm families only
    WsRipple R = SandRipples(Wg_, p, N, fp, flow, trough0, crest0, mA, mB, mC, dust, G.noRipple, G.haze);
    float hr = R.hr, fade = R.fade, trough = R.trough; float2 slope = R.slope; float macR = mC.r;
    float3 sand = lerp(G.cSand, G.cSandD, sat(Wg_, smoothstep(0.35, 0.70, F20*0.5 + macR*0.5)*0.8 + 0.45*trough0));                              // darker sand in patches of 5 to 20 m (R.sort is offered, not used here: Style rules on sorting first)
    sand *= (0.94 + 0.12*macR) * R.tone;
    float3 ns = normalize(float3(-slope, 1.)); float aos = 1. - 0.08*sat(Wg_, 0.5 - 0.5*hr)*fade, rs = 0.9;
    // debris (0.2 m tile, stochastic): pieces show whole where the local density beats their rank; more in troughs and in clumps
    float dens = 0.;
    if (!dust) { float dl = mD.r - 0.1 + 0.91*(WS_F_DL(p) - 0.0714);
      dens = 0.3 * sat(Wg_, (dl + 0.2*fb(Wg_, float3(p/0.48, 31.)) - 0.42)*5.) * (0.1 + 1.9*pow(trough, 1.5)); }
    float dk = sat(Wg_, (0.012 - fp)/0.006) * step(0.01, sandM);     // debris fades out where a pixel covers more than about 1 cm; dusting on rock tops is a film: no debris pieces or grains there
    if (dk > 0. && dens > 0.005) { St ds = stGrid(Wg_, p/0.20 + 1.7); float3 w3 = ds.w*ds.w*ds.w; w3 /= (w3.x + w3.y + w3.z); float best = 0.; float4 D = f4(Wg_, 0.); float3 Dn = float3(0., 0., 1.);
      for (int i = 0; i < 3; i++) { float2 u = i == 0 ? ds.u0 : i == 1 ? ds.u1 : ds.u2; float q = i == 0 ? ds.q0 : i == 1 ? ds.q1 : ds.q2; float wi = i == 0 ? w3.x : i == 1 ? w3.y : w3.z;
        float4 d4 = sg(Wg_, TEXUSE(dBC), u, q, ds), m4 = sg(Wg_, TEXUSE(dM), u, q, ds); float vis = sat(Wg_, (dens*wi*3. - m4.g)*12.) * d4.a;
        if (vis > best) { best = vis; D = d4; float3 t3 = unpackN(Wg_, sg(Wg_, TEXUSE(dN), u, q, ds)); t3.xy = qrot(Wg_, t3.xy, pmod(Wg_, 4. - q, 4.)); Dn = t3; } }
      float cover = best*dk; float3 dcol = lerp(G.cRubA, G.cRubB, sat(Wg_, lum(Wg_, toLin(Wg_, D.rgb))*1.6)) * 1.05;
      sand = lerp(sand, dcol, cover); ns = normalize(lerp(ns, normalize(float3(Dn.xy*1.5 - slope, Dn.z)), cover)); rs = lerp(rs, 0.55, cover); }
    sand = lerp(sand, G.cRubMid, sat(Wg_, dens*1.2)*(1. - dk)*0.5);                                                // far away the clumps stay as a faint mottle instead of vanishing
    // grains (17 mm tile, stochastic), only where a pixel is finer than 2 to 3 mm
    float gk = sat(Wg_, (0.003 - fp)/0.001) * step(0.01, sandM);
    if (gk > 0.) { St gs = stGrid(Wg_, p/0.017 + 0.9); float3 w3 = gs.w*gs.w*gs.w; w3 /= (w3.x + w3.y + w3.z); float3 gm = stC(Wg_, TEXUSE(gM), gs, w3), gc = toLin(Wg_, stC(Wg_, TEXUSE(gBC), gs, w3))/G.mGrain, gn = stN(Wg_, TEXUSE(gN), gs, w3);
      float hg = sat(Wg_, (gm.r - 0.25)*2.), cv = (0.5 + 0.5*hg)*lerp(1., gm.b, 0.5); sand *= lerp(f3(Wg_, 1.), gc*lerp(1., cv, 0.6)/0.86, gk); ns = normalize(float3(ns.xy + gn.xy*1.8*gk, ns.z)); }
    float sm = max(sandM, ledge*0.85);
    alb = lerp(alb, lerp(sand, G.cSandD*(0.95 + 0.1*macR), ledge*(1. - sandM)), sm); n = normalize(lerp(n, float3(ns.xy + Wg_.gNn.xy, ns.z*Wg_.gNn.z), sm)); ao = lerp(ao, aos, sm); rough = lerp(rough, rs, sm);
    if (G.glit > 0. && sandM > 0.5) { float3 toC = G.cam - P; float dC = length(toC); float4 gl = Glitter(Wg_, P, n, toC/max(dC, 1e-3), G.sun, Wg_.gDP, dC, G.glit);
      n = normalize(lerp(n, gl.yzw, gl.x)); rough = lerp(rough, 0.28, gl.x); ao = lerp(ao, 1., gl.x); } }
  S.alb = alb; S.n = n; S.ao = ao; S.rough = rough; return S; }

// =====================================================================================================================
// M_Tree_Coat: the tree keeps its own colour; the coat adds skin grain only
// =====================================================================================================================
// aux = (foot 0..1, tip 0..1) from the tree maker; aux.x < 0 = not given: foot from the height over floorZ, tip from the colour's lightness
WsSurf TreeCoat(inout WsG Wg_, float3 P, float3 N, float fp0, float3 vc, float2 aux, float film, float coatK, float floorZ, WsPolyp Q, TEXARG(coatBC), TEXARG(coatN), TEXARG(coatORM)){
  WsSurf S; S.fp = wsBegin(Wg_, P, N, fp0); float up = N.z;
  float3 c2, o, n2; float foot = 1. - smoothstep(0.6, 1.8, P.z - floorZ), under = smoothstep(0.2, 0.7, -up);
  float tip = smoothstep(0.55, 0.75, lum(Wg_, vc) / lum(Wg_, toLin(Wg_, float3(0.945, 0.655, 0.710))));
  if (aux.x >= 0.) { foot = smoothstep(0.35, 0.85, aux.x); tip = smoothstep(0.25, 0.75, aux.y); }
  float k = coatK * (1. + 0.6*foot - 0.55*under - 0.35*tip) * (1. - film);   // film = the share of sand lying on the bark (trunk feet): no skin grain under it
  tileRead(Wg_, TEXUSE(coatBC), TEXUSE(coatN), TEXUSE(coatORM), 0.25, k, c2, o, n2);
  S.alb = vc * lerp(1., c2.r*2., clamp(k, 0., 1.6)) * (0.97 + 0.06*fb(Wg_, P/0.9 + 3.));
  S.n = n2; S.ao = lerp(1., o.r, 0.6); S.rough = clamp(o.g + 0.22*foot - 0.12*under, 0.3, 0.95);
  S.pm = polypMask(Wg_, Q, S.n); return S; }

// =====================================================================================================================
// M_Coral_Detail v2: Colony maker's own pattern, colour-free per kind (texgrow_coral.py), read at random per patch; the colony keeps its record colour
// =====================================================================================================================
// zones from Colony's per-vertex data: aux.x = part/3 (0 body, 1 growing tip, 2 groove, 3 capped top), aux.y = surfMask (where the pattern is allowed); aux.x < 0 = none
// xT, xK = the kind's tile size (m) and strength; cm = (type 0 none 1 lumps 2 tips, size m, depth m): Colony's centimetre layer, from world noise;
// mdr = meander kinds (valley spacing, depth, septa spacing, depth, all mm; x = 0 for tile kinds). Pc = the position the millimetre valleys are
// computed on: the colony's own (local) position in Unreal, so the pattern is exact at any distance from the world origin and moves with the colony.
WsSurf CoralDetail(inout WsG Wg_, float3 P, float3 Pc, float3 N, float fp0, float3 vc, float2 aux, float xT, float xK, float3 cm, float4 mdr, WsPolyp Q, TEXARG(xBC), TEXARG(xN), TEXARG(xORM)){
  WsSurf S; float fp = wsBegin(Wg_, P, N, fp0); S.fp = fp;
  float part = floor(aux.x*3. + 0.5), smk = aux.x < 0. ? 1. : clamp(aux.y, 0., 1.5);
  float k = xK * smk * (part > 0.5 && part < 1.5 ? 0.6 : part > 1.5 && part < 2.5 ? 1.3 : 1.);
  float3 c2 = f3(Wg_, 0.5), o = f3(Wg_, 1.), n2 = Wg_.gNn;
  if (xK > 0.) tileRead(Wg_, TEXUSE(xBC), TEXUSE(xN), TEXUSE(xORM), xT, k, c2, o, n2);   // COST (12 Nov): xK = 0 (brain: the meander replaces the tile) used none of the read; xK is the kind's, one value per material
  // centimetre layer (Colony's type3: lumps, tips), from world noise, so it has no period; bump by screen derivatives (as Colony's SURF_GLSL)
  float h3 = 0., c3 = 0.;
  if (cm.x > 0.5 && cm.z > 0.) { float3 q = P/cm.y; if (cm.x < 1.5) { q += 0.45*(float3(vn3(Wg_, P/(1.7*cm.y)), vn3(Wg_, P/(1.7*cm.y) + 17.), vn3(Wg_, P/(1.7*cm.y) + 41.)) - 0.5);
      float a = (vn3(Wg_, q) + 0.5*vn3(Wg_, 2.*q + 5.3))/1.5; h3 = smoothstep(0.2, 0.75, a) - 0.5; c3 = (1. - smoothstep(0.15, 0.5, a))*0.6; }
    else { float2 w = worley3(Wg_, q); h3 = (1. - smoothstep(0.05, 0.42, w.x)) - 0.35; c3 = smoothstep(0.35, 0.62, w.x)*0.9; }
    float f3k = sat(Wg_, (cm.y/(fp*2.) - 2.)/3.); h3 *= cm.z*f3k*smk; c3 *= f3k*smk; }
  // meander kinds: Colony's phasor valleys and septa, per pixel, in place of the tile
  if (mdr.x > 0.) { float fw = fp*1000., fM = fadeOf(Wg_, mdr.x, fw);
    if (fM > 0.) { float2 ph = phasorPh(Wg_, Pc*1000., N, mdr.x, mdr.z); float hh = smoothstep(-0.2, 0.95, cos(ph.x)), wSep = 4.*hh*(1. - hh) + 0.3*hh;
      h3 += (mdr.y*(hh - 0.5)*fM + mdr.w*cos(ph.y)*wSep*fadeOf(Wg_, mdr.z, fw))*0.001*smk; c3 = max(c3, (1. - hh)*fM*smk); } }
  { float3 dpx = ddx(P), dpy = ddy(P); float dhx = ddx(h3), dhy = ddy(h3); float3 r1 = cross(dpy, n2), r2 = cross(n2, dpx); float det = dot(dpx, r1);
    n2 = normalize(abs(det)*n2 - sign(det)*(dhx*r1 + dhy*r2)); }
  S.alb = vc * lerp(1., c2.r*2., clamp(k, 0., 1.)) * (1. - 0.45*c3) * (0.95 + 0.10*fb(Wg_, P/0.9 + 3.)); S.n = n2; S.ao = lerp(1., o.r, 0.7*clamp(k, 0., 1.)) * (1. - 0.3*c3); S.rough = 0.7;
  S.pm = polypMask(Wg_, Q, S.n); return S; }

// =====================================================================================================================
// Coral surface recipe v1 (13 Nov; Style's targets papers/process/art_bible/proposals/surface_recipe_targets.md): ONE function for every coral
// class, per-class parameters only. The bar is the hand-made bommie (M_Ground_Blend), so its pieces are reused as they are there:
//  1. fine detail: the bommie's own grown rock tile (no photo pixels), at the bommie's density (detT, 0.30 m), read on the same stochastic
//     triplanar grids (bent cells, random turn per patch: no repeat) - colour-free, normal + AO only;
//  2. middle scale: the bommie's weathering hollows (its 0.55 m / 0.16 m fields warped by the 1.2 m / 6 m ones) as relief and cavity, x rc.w;
//     Colony's centimetre layer and the meander (brain) kept as relief;
//  3. cavity from the mesh: distance-field AO (dfao, 1 = open) and the world normal (undersides, inward faces), plus the detail's own AO;
//  4. tone ramp, three tones: record colour (base), record x rc.x (crevice/underside), tops x rc.y; identity = a C_turf film on open tops, x rc.z.
// rc = (CavDark, TopLift, FilmAmt, PitK); the record colour vc stays the one colour source.
WsSurf CoralRecipe(inout WsG Wg_, float3 P, float3 Pc, float3 N, float fp0, float3 vc, float2 aux, float3 cm, float4 mdr, float dfao, float4 rc, float detT, float3 cTurf,
    WsPolyp Q, TEXARG(dBC), TEXARG(dN), TEXARG(dORM)){
  WsSurf S; float fp = wsBegin(Wg_, P, N, fp0); S.fp = fp; float up = N.z;
  float smk = aux.x < 0. ? 1. : clamp(aux.y, 0.25, 1.5);
  // v36 LEVEL 3 "clean at a distance, real up close" (STYLE_DIAL_LAB U9; FINISH_PASS S2-S4), all x the dial Wg_.gStyle (0 = v35 exactly):
  // detail distance from the pixel's footprint (fp / 0.00142 = metres at the reference 1080p, 75 deg view): full within 0.25 m, the far value
  // 0.25 by 1.0 m; the underside of a cover (a table coral, a head's cap) smoother still (S4); the 0.55 m / 0.16 m hollows sited by wear
  // (open, lit, the 1.2 m field) instead of everywhere at one scale (S3, S4); the turf film drawn as one clean zone on lit tops (S1).
  float sty = sat(Wg_, Wg_.gStyle), dEst = fp/0.00142, underS = 1. - smoothstep(-0.6, 0.2, up);
  float dk = lerp(1., lerp(1., 0.25, smoothstep(0.25, 1.0, dEst))*(1. - 0.6*underS), sty);
  float3 c2, o, n2; tileRead(Wg_, TEXUSE(dBC), TEXUSE(dN), TEXUSE(dORM), detT, dk, c2, o, n2); o = lerp(f3(Wg_, 1.), o, dk);
  // the bommie's fields (WorldSurface GroundBlend: F1, F1b from 1.2 m, F6 from 6 m, hollows from 0.55 m / 0.16 m warped by them)
  float2 f12 = fbm3v(Wg_, P/1.2 + 31.7); float F1 = fbS(Wg_, f12.x), F1b = fbS(Wg_, f12.y), F6 = 0.5;   // COST: the 6 m field is flat across a colony (< 2 m): its mean
  float3 wv3 = 1.2*(float3(F1b, F6, F1) - 0.5); float F05 = fbS(Wg_, fbm2n(Wg_, P/0.55 + 91. + wv3)), F015 = fbS(Wg_, fbm2n(Wg_, P/0.16 + 63. + wv3*1.7));
  float pit = smoothstep(0.56, 0.82, F05*0.62 + F015*0.38)*0.8 * smoothstep(0.35, 0.65, 0.6*F1 + 0.4*(1. - F6)) * rc.w;
  pit *= dk * lerp(1., smoothstep(0.30, 0.70, 0.5*F1 + 0.5*sat(Wg_, dfao))*smoothstep(-0.2, 0.4, up), sty);   // v36: wear sites the hollows
  // relief: hollows (up to 12 mm deep), Colony's centimetre layer, the meander; bump by screen derivatives
  float h3 = -0.012*pit, c3 = 0.;
  if (cm.x > 0.5 && cm.z > 0.) { float3 q = P/cm.y; if (cm.x < 1.5) { q += 0.45*(float3(vn3(Wg_, P/(1.7*cm.y)), vn3(Wg_, P/(1.7*cm.y) + 17.), vn3(Wg_, P/(1.7*cm.y) + 41.)) - 0.5);
      float a = (vn3(Wg_, q) + 0.5*vn3(Wg_, 2.*q + 5.3))/1.5; h3 += (smoothstep(0.2, 0.75, a) - 0.5)*cm.z*smk*sat(Wg_, (cm.y/(fp*2.) - 2.)/3.); c3 = (1. - smoothstep(0.15, 0.5, a))*0.6; }
    else { float2 w = worley3(Wg_, q); h3 += ((1. - smoothstep(0.05, 0.42, w.x)) - 0.35)*cm.z*smk*sat(Wg_, (cm.y/(fp*2.) - 2.)/3.); c3 = smoothstep(0.35, 0.62, w.x)*0.9; }
    c3 *= sat(Wg_, (cm.y/(fp*2.) - 2.)/3.)*smk; }
  if (mdr.x > 0.) { float fw = fp*1000., fM = fadeOf(Wg_, mdr.x, fw);
    if (fM > 0.) { float2 ph = phasorPh(Wg_, Pc*1000., N, mdr.x, mdr.z); float hh = smoothstep(-0.2, 0.95, cos(ph.x)), wSep = 4.*hh*(1. - hh) + 0.3*hh;
      h3 += (mdr.y*(hh - 0.5)*fM + mdr.w*cos(ph.y)*wSep*fadeOf(Wg_, mdr.z, fw))*0.001*smk; c3 = max(c3, (1. - hh)*fM*smk); } }
  h3 *= lerp(1., dk, sty); c3 *= lerp(1., dk, sty);   // v36 (dk is 1 at dial 0: written so the dial-0 path is v35's)
  { float3 dpx = ddx(P), dpy = ddy(P); float dhx = ddx(h3), dhy = ddy(h3); float3 r1 = cross(dpy, n2), r2 = cross(n2, dpx); float det = dot(dpx, r1);
    n2 = normalize(abs(det)*n2 - sign(det)*(dhx*r1 + dhy*r2)); }
  // cavity: the mesh (distance-field AO, undersides) first, the detail's own hollows after
  float under = 1. - smoothstep(-0.6, 0.2, up);
  // v23 (sa99 read-outs, calibrated on FilmAmt 0.84/0.85): open flanks read dfao 0.8 and still counted 0.26 cavity, so cav covered 72-78 % of the
  // piece, CavDark darkened it all evenly and top lift / film (x (1 - cav)) vanished. Only real occlusion counts now (dfao under 0.66).
  float cavM = sat(Wg_, max(under*0.85, (0.66 - sat(Wg_, dfao))*2.4));
  float cavD = sat(Wg_, (1. - o.r)*1.6 + pit*0.5 + c3*0.5);
  // v23: at diver height 65-75 % of what shows is flank (up under 0.3), so the lit zone starts at the shoulder, not the flat top
  float cav = sat(Wg_, cavM + 0.6*cavD), topM = smoothstep(-0.10, 0.60, up)*(1. - cav);
  float3 alb = vc * lerp(1., rc.x, cav) * lerp(1., rc.y, topM) * lerp(1., o.r, 0.35) * (0.94 + 0.12*F1);   // low-frequency drift over metres: no flat colour, no lattice
  // v23: the film's gate was the 1.2 m field, one patch per piece (sa99: boulder 0.13, table 0.75): now the 0.55 m / 0.16 m hollows' fields
  // (several patches on every piece, same cost); it sits on open shoulders and flanks (dfao over 0.40), never in the hollows
  float gateF = lerp(smoothstep(0.42, 0.58, F05*0.7 + F015*0.3), 1., 0.8*sty);   // v36: one clean turf zone on lit tops (S1, zones 80 %)
  float fw = rc.z * smoothstep(0.0, 0.50, up) * sat(Wg_, (dfao - 0.40)*3.) * (1. - 0.7*cavD) * gateF;
  alb = lerp(alb, cTurf*(0.92 + 0.16*F05), fw);
  S.alb = alb; S.n = n2; S.ao = lerp(1., o.r, 0.6)*(1. - 0.25*pit); S.rough = lerp(0.70, 0.85, fw);
  // v19 (sa73: film read 0 everywhere while dfao, up and the top mask read fine): modes 2 and 3 show the film's own factors and the recipe vector
  Wg_.gDbg = Wg_.gDbgMode < 0.5 ? float3(fw, topM, cav) : Wg_.gDbgMode < 1.5 ? float3(sat(Wg_, dfao), 0.5 + 0.5*up, cavD)
       : Wg_.gDbgMode < 2.5 ? float3(rc.z, gateF, 1. - 0.7*cavD) : float3(rc.x, 0.5*rc.y, rc.w);
  S.pm = polypMask(Wg_, Q, S.n); return S; }

// ---------- lab stress test: any single tile on any mesh (corals, loose rocks); colour stays the mesh's own ----------
// =====================================================================================================================
// WETLINE: the sea's mark on anything that crosses the surface, drawn every frame from the live water (Gary 14 Nov 03:09Z: "Waterline and
// wet film should not be baked. Real time root fix"; Rock's world/rock/lagoon/WATERLINE_MATERIAL_RULE.md; Style guide 2.11). ONE function:
// rock heads now, the beach's wet sand and anything else at the surface later. Nothing about the water is stored in an asset.
// in:  z (m), zSea the live sea surface over this xy (m; lagoonwater's sea_height contract), zStill the still level (m; MPC_Ocean SurfaceZ),
//      hs the live significant wave height (m; feeds the stand-in film), mem wet-film memory 0..1 (Water surface's render target; < 0 = not
//      there yet: wet up to zStill + hs/2, the rule's stand-in), cav 0..1 cavity (holds water: the film reaches 0.5-2x as far, so the drying
//      edge follows the form), fp metres a pixel covers.
// out: x = under the live surface, y = wet above it (meniscus 3-5 cm + film), z = weathered (above still water: years of sun, not the
//      live wave), w = red allowed (1 below zStill - 0.25 m, 0 from zStill - 0.2 m up: coralline stays under that).
float4 Wetline(inout WsG Wg_, float z, float zSea, float zStill, float hs, float mem, float cav, float fp){
  float e = max(fp, 0.004);
  float under = 1. - smoothstep(zSea - e, zSea + e, z);
  float men = 1. - smoothstep(zSea, zSea + 0.04 + e, z);
  float top = zStill + 0.5*max(hs, 0.)*lerp(0.5, 2.0, sat(Wg_, cav));
  float film = mem >= 0. ? mem : 1. - smoothstep(top - 0.015 - e, top + 0.015 + e, z);
  float wet = max(men, film)*(1. - under);
  float dry = smoothstep(zStill - 0.02, zStill + 0.06, z);
  float red = 1. - smoothstep(zStill - 0.25, zStill - 0.20, z);
  return float4(under, wet, dry, red); }
// v33 MIRROR STRENGTH FOLLOWS THE MEDIUM (Style ruling 14 Nov 09:15Z, WATERLINE_MATERIAL_RULE.md addition; check WM6 = Lighting's lr87 black
// card at 1 m under water near the no-mirror L* 25). Unreal's Specular is F0 / 0.08 for a dielectric; F0 = ((n - n0)/(n + n0))^2 from the
// surface's own index n against what touches it: under the live surface seawater (n0 1.34), in the wet film above it the film's own water
// face against air (1.333 vs 1), dry air (1). Same weights as the waterline rule: W.x under -> in-water, W.y wet -> air-water, else air.
// No hand value: n is the material's (rock and carbonate sand 1.60, living tissue 1.40, leaf cuticle 1.47). trueK 1 = true; the nodes blend this
// with v32's fixed value by MPC_WorldLook.MirrorByMedium (0 = v32 exactly, the installed default during Gary's break 14 Nov; 1 = the ruling).
float wsSpecF0(inout WsG Wg_, float n, float n0){ float r = (n - n0)/(n + n0); return r*r/0.08; }
float WsSpecular(inout WsG Wg_, float4 W, float n, float trueK){
  float dry = wsSpecF0(Wg_, n, 1.), film = wsSpecF0(Wg_, 1.333, 1.), under = lerp(dry, wsSpecF0(Wg_, n, 1.34), sat(Wg_, trueK));
  return lerp(lerp(dry, film, sat(Wg_, W.y)), under, sat(Wg_, W.x)); }
// the same for a surface with no live waves wired (corals, trees, caves, ground, grass): the still level only, no film memory.
float WsSpecStill(inout WsG Wg_, float z, float zStill, float n, float trueK, float fp){ return WsSpecular(Wg_, Wetline(Wg_, z, zStill, zStill, 0., -1., 0., fp), n, trueK); }
// v33 (REALISM_TABLE A1): the head's tone is Rock's grown colour against the head's OWN median (toneRef, measured per kit: kit v18b 0.283
// linear, sa322 / headlife zip), so the head's median is C_rock and only its variation is Rock's. v31 divided by C_rock (0.17), so most of
// a kit head sat on the 1.45 clamp. The clamp stays as a guard. A white head (LagoonSlice, no grown colour) still clamps: it needs colour.
// toneRef 0 (MI HeadToneRef, the installed default) = v31/v32 exactly (divide by C_rock).
float3 wsHeadTone(inout WsG Wg_, float3 vl, float3 cRock, float toneRef, float headK){
  float ref = toneRef > 0. ? toneRef : lum(Wg_, cRock);
  return lerp(cRock*clamp(lum(Wg_, vl)/max(ref, 1e-4), 0.55, 1.45), vl, sat(Wg_, headK)); }
// M_ReefRock (Rock's heads and the reef kit): today's look under water (seabed_reef v1's vertex colour: R exposure 0 crevice, 0.5 turf, 1 pale
// rock; G bleached rubble), and above the sea Style's two rock states (guide 2.11, 00:42Z): dry weathered mid grey cDry (L* 50-55, chroma ~5)
// and wet olive grey cWet (L* 35-40, hue 70-100, chroma < 8) with a soft sheen. The rock's own exposure keeps its form in both.
// v31 (Style 14 Nov 05:48Z: the heads read as smooth clay): the rock under the waterline is the SHARED rock recipe (CoralRecipe: the bommie's own
// grown rock tile, cavity from distance-field AO + the tile, top lift, pits, turf film on open shoulders), the waterline drawn on top of it.
// Two vertex-colour codes reach this material (reef kit v14+): the kit's rubble carries the ramp code (R exposure, G bleach, B exactly 0,
// seabed_reef v1); the heads' slot carries Rock's grown colour itself (sRGB, never B 0; kit "LagoonHead_VC", sand film blended in). B tells them apart.
// Style 05:55Z: heads, boulders and caves are one limestone: the heads take the grey rock colour (C_rock) with Rock's grown colour as TONE only
// (headK 0); headK 1 = Rock's colour as is. Colour on rock comes from life (the recipe's turf film), never from the base.
WsSurf ReefRock(inout WsG Wg_, float3 P, float3 N, float fp0, float3 vc, float dfao, float4 rc, float detT, float3 cTurf, float3 cRock, float headK, float toneRef,
    float zSea, float zStill, float hs, float mem, float3 cDry, float3 cWet, TEXARG(dBC), TEXARG(dN), TEXARG(dORM)){
  float isCol = step(0.02, vc.b);
  float ex = lerp(sat(Wg_, vc.r), sat(Wg_, (vc.r - 0.40)/0.40), isCol);
  float3 c = lerp(lerp(float3(0.022, 0.020, 0.015), float3(0.150, 0.140, 0.085), sat(Wg_, ex*2.)), float3(0.45, 0.43, 0.37), sat(Wg_, ex*2. - 1.));
  float3 head = wsHeadTone(Wg_, toLin(Wg_, vc), cRock, toneRef, headK);
  c = lerp(lerp(c, float3(0.62, 0.60, 0.54), sat(Wg_, vc.g)), head, isCol);
  WsPolyp Q; Q.cell = 0.025; Q.pat = float3(0.30, 0.85, 0.3); Q.fd = float2(0.12, 0.4);   // the recipe's polyp mask is not used here (compiled out)
  WsSurf S = CoralRecipe(Wg_, P, P, N, fp0, c, float2(-1., 0.), f3(Wg_, 0.), f4(Wg_, 0.), dfao, rc, detT, cTurf, Q, TEXUSE(dBC), TEXUSE(dN), TEXUSE(dORM));
  float detail = clamp(lum(Wg_, S.alb)/max(lum(Wg_, c), 1e-4), 0.45, 1.4);                    // the recipe's own tone (pits, cavities, top lift) carried above water
  float4 W = Wetline(Wg_, P.z, zSea, zStill, hs, mem, sat(Wg_, 1. - S.ao*1.15 + 0.3*(1. - ex)), S.fp); Wg_.gWet = W;   // v33: the node's Specular reads it
  float3 a = lerp(S.alb, cDry*detail, W.z);
  a = lerp(a, lerp(f3(Wg_, lum(Wg_, a)), a, 0.3), (1. - W.w)*sat(Wg_, (a.r - a.g)*20.));        // no pink or red near and above the still level
  float wet = max(W.y, W.x*W.z);                                                    // a crest over the dry top leaves it wet, not marine
  a = lerp(a, cWet*detail, wet*W.z + W.y*(1. - W.z)*0.5);                          // below still water a wet edge only darkens a little
  S.alb = a; S.pm = 0.;
  S.rough = lerp(lerp(S.rough, 0.92, W.z), 0.32, wet);                              // soft sheen (Style: wet pixels over L* 96 under 0.05 %)
  return S; }
WsSurf SingleTile(inout WsG Wg_, float3 P, float3 N, float fp0, float3 vc, float xT, float xK, float3 mX, WsPolyp Q, TEXARG(xBC), TEXARG(xN), TEXARG(xORM)){
  WsSurf S; S.fp = wsBegin(Wg_, P, N, fp0);
  float3 c2, o, n2; tileRead(Wg_, TEXUSE(xBC), TEXUSE(xN), TEXUSE(xORM), xT, xK, c2, o, n2); float3 d = toLin(Wg_, c2)/mX; d = lerp(f3(Wg_, lum(Wg_, d)), d, 0.5);
  S.alb = vc * d * (0.92 + 0.16*fb(Wg_, P/1.4 + 3.)); S.n = n2; S.ao = o.r; S.rough = o.g;
  S.pm = polypMask(Wg_, Q, S.n); return S; }
