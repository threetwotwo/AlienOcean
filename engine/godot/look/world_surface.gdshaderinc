float3 r3(inout WsG Wg_, float3 p){ return float3(0.7071*p.x - 0.7071*p.y, 0.5657*p.x + 0.5657*p.y + 0.6*p.z, -0.4243*p.x - 0.4243*p.y + 0.8*p.z); }
